# Supabase Configuration (shared with the POS's Supabase project)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth Configuration (Android-only — no iOS client)
# Web and Android must be DISTINCT client IDs from Google Cloud Console
# (Credentials > OAuth 2.0 Client IDs) — one per platform/client type.
# The web client ID must also be registered as a Google provider in the
# Supabase dashboard (Authentication > Providers > Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
